<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Please Wait - LootLinks</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Simple header for gate page -->
  <nav class="navbar">
    <div class="navbar-container">
      <a href="/index.html" class="navbar-logo">
        🔗 LootLinks
      </a>
    </div>
  </nav>

  <div class="navbar-spacer"></div>

  <div class="container">

    <main>
      <div id="loadingState" class="gate-container">
        <div class="loading">Loading...</div>
      </div>

      <div id="gateState" class="gate-container" style="display: none;">
        <div class="gate-header">
          <h2>Please View Our Sponsors</h2>
          <p>Complete <strong id="totalAds">0</strong> sponsor views to continue to your destination</p>
        </div>

        <div class="compliance-notice-small">
          ⚠️ <strong>Demo Mode:</strong> This MVP uses placeholder sponsor content for demonstration purposes only.
        </div>

        <div id="adCardsContainer" class="ad-cards-container"></div>

        <div class="gate-actions">
          <button id="continueBtn" class="btn btn-primary btn-large" disabled>
            Continue to Destination
          </button>
          <div id="continueMessage" class="continue-message"></div>
        </div>
      </div>

      <div id="errorState" class="gate-container error-container" style="display: none;">
        <h2>⚠️ Error</h2>
        <p id="errorMessage"></p>
        <a href="/" class="btn btn-secondary">Go Home</a>
      </div>
    </main>
  </div>

  <!-- Simple footer for gate page -->
  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-bottom" style="border-top: none; padding-top: 0;">
        <div class="footer-copyright">
          &copy; 2026 LootLinks. All rights reserved.
        </div>
      </div>
    </div>
  </footer>

  <script src="/gate.js"></script>
</body>
</html>
